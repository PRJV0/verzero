# Copia in .env.local e compila. .env.local NON va committato.

# Supabase — progetto in regione EU (Francoforte), vedi SPEC §2 e §8
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: bypassa la RLS. Mai esporre al browser, mai prefissare NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — usata solo lato server per l'estrazione documenti (fase 2)
ANTHROPIC_API_KEY=
# Modello di estrazione: parametro, non scelta fissata nel codice.
# Decisione rimandata alla fase 2, con benchmark su bollette reali.
# Lasciare vuoto per usare il default di src/lib/ai/config.ts.
ANTHROPIC_EXTRACTION_MODEL=
ANTHROPIC_EXTRACTION_MAX_TOKENS=2000

# Email transazionali via Resend (SPEC §12.E).
# Due usi distinti della stessa chiave:
#  - SMTP del progetto Supabase per le email di autenticazione (recupero
#    password, link di accesso): si applica con
#    `node --env-file=.env.local scripts/configura-smtp.mjs`;
#  - API Resend per le notifiche applicative (src/lib/email.ts).
RESEND_API_KEY=
# Mittente delle email di autenticazione (deve stare sul dominio verificato)
RESEND_FROM_EMAIL=no-reply@verzero.it
# Mittente delle notifiche applicative, con nome visualizzato
RESEND_FROM=Ver0 <no-reply@verzero.it>
# Dove arrivano le notifiche interne (es. nuovo messaggio dai contatti)
RESEND_NOTIFICHE_A=info@verzero.it

# Token personale Supabase per la Management API (migrazioni e config SMTP)
SUPABASE_ACCESS_TOKEN=

# Modalità pre-lancio (SPEC §12.B): a "false" (o assente) il funnel
# raccoglie richieste di attivazione invece di vendere. Mettere a "true"
# quando i pagamenti si accendono: il codice è già tutto lì.
NEXT_PUBLIC_PAGAMENTI_ATTIVI=false

# Verifica della proprietà del dominio sui motori di ricerca.
# Google: Search Console → Aggiungi proprietà → prefisso URL → tag HTML,
# e qui va SOLO il valore dell'attributo content.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools → importa da Search Console (più rapido) oppure
# verifica con meta tag e incolla qui il valore.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# URL pubblico dell'app, usato per i redirect di autenticazione
NEXT_PUBLIC_SITE_URL=http://localhost:3000
